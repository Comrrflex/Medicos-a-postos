PORT=3000
DATABASE_PATH=./clinical.db
SESSION_HOURS=12
# Separe múltiplas origens com vírgula. Deixe vazio para uso somente same-origin.
CORS_ORIGIN=

# OAuth 2.1 / Auth0 usado pelo app público
AUTH_ISSUER=https://seu-tenant.auth0.com/
AUTH_AUDIENCE=https://api.medicosapostos.example
AUTH_JWKS_URL=https://seu-tenant.auth0.com/.well-known/jwks.json
AUTH_EMAIL_CLAIM=https://medicos-a-postos.com/email
AUTH_EMAIL_VERIFIED_CLAIM=https://medicos-a-postos.com/email_verified
